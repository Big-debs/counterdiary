# =====================================================
# THE LEDGER - PRODUCTION ENVIRONMENT VARIABLES (BACKEND)
# =====================================================

# 1. DATABASE
# Use your cloud provider's details (e.g., Supabase, Railway, RDS)
DB_HOST=your-db-host.provider.com
DB_PORT=5432
DB_USER=production_user
DB_PASSWORD=your_secure_production_password
DB_NAME=ledger

# 2. REDIS
# Use your cloud provider's details (e.g., Upstash)
REDIS_URL=redis://:password@host:port

# 3. SECURITY
# Generate a long random string for JWT
JWT_SECRET=your_long_random_jwt_secret
# The URL of your Vercel deployment
FRONTEND_URL=https://counterdiary-your-project.vercel.app

# 4. SMS (TWILIO)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=your_twilio_number

# 5. INITIAL SETUP 
# Set this once to bootstrap your first admin account
ADMIN_BOOTSTRAP_KEY=set_a_secure_bootstrap_key_once

# 6. APP SETTINGS
NODE_ENV=production
# The port the app runs on (usually 3000)
PORT=3000
